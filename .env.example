# Copy to .env and fill in. Generate a token at https://www.discogs.com/settings/developers
# .env is git-ignored. Never put a real token in this file.
DISCOGS_PAT=

# Apple Developer Team ID, used for code signing. Find it in Xcode > Settings > Accounts,
# or in the parentheses of `security find-identity -v -p codesigning`.
# `make generate` projects this into Config/Local.xcconfig so Xcode picks it up.
DEVELOPMENT_TEAM=
