# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/

# Secrets — never commit
.env
.env.local

# Generated by XcodeGen (source of truth is project.yml)
# The .xcodeproj, Info.plist and entitlements are regenerated by `xcodegen generate`,
# so they are not tracked.
*.xcodeproj/
Config/*.plist
Config/*.entitlements
# Hand-written, not generated: iOS needs entitlements macOS rejects.
!Config/Recogs-iOS.entitlements
# Projected from .env by `make generate`; Config/Base.xcconfig includes it optionally.
Config/Local.xcconfig

# Shared coding-agent guidance (overrides personal/global ignore rules).
!CLAUDE.md
